{
  "name": "nyarbot",
  "version": "1.0.0",
  "description": "personal telegram bot",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "serve": "pm2 start dist/app.js --name nyarbot --node-args=\"--env-file=.env\"",
    "serve:restart": "pm2 restart nyarbot",
    "serve:stop": "pm2 stop nyarbot",
    "serve:logs": "pm2 logs nyarbot",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "npm run build && node --import=./dist/test-setup.js --test \"dist/**/*.test.js\"",
    "test:coverage": "npm run build && node --import=./dist/test-setup.js --test --experimental-test-coverage --test-coverage-include=dist/**/*.js --test-coverage-exclude=dist/**/*.test.js --test-coverage-lines=85 --test-coverage-functions=90 --test-coverage-branches=82 \"dist/**/*.test.js\"",
    "test:random": "npm run build && node --import=./dist/test-setup.js --test --test-randomize \"dist/**/*.test.js\"",
    "backup:restore": "npm run build && node dist/scripts/restore-sqlite-backup.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinyanfr/nyarbot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/yinyanfr/nyarbot/issues"
  },
  "homepage": "https://github.com/yinyanfr/nyarbot#readme",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.61",
    "@grammyjs/auto-retry": "^2.0.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/canvas": "^1.0.2",
    "@tavily/ai-sdk": "^0.5.0",
    "@xzxzzx/bilibili-mcp": "1.10.1",
    "ai": "^6.0.175",
    "ai-gateway-provider": "^3.1.3",
    "better-sqlite3": "^12.11.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "grammy": "^1.42.0",
    "nodejieba": "^3.5.8",
    "opencc-js": "^1.4.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "overrides": {
    "uuid": "11.1.1",
    "js-yaml": "4.3.1",
    "tar": "7.5.22",
    "@mapbox/node-pre-gyp": "2.0.3",
    "pm2": {
      "ws": "8.21.0",
      "js-yaml": "4.3.1"
    }
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
